# Fuzz harness build recipe.
#
# Scaffold for Rec 13: see docs/security/OSS_FUZZ.md.
#
# Usage:
#   make -f Makefile.fuzz fuzz_xml
#   make -f Makefile.fuzz ASAN=1 UBSAN=1 fuzz_xml
#   make -f Makefile.fuzz all
#
# OSS-Fuzz overrides CXX/CXXFLAGS/LIB_FUZZING_ENGINE itself; this
# Makefile is for local reproduction.

# `?=` would never fire here: GNU Make *predefines* CXX (to g++), so the
# variable is always "defined" and the conditional assignment is dead —
# and g++ has no -fsanitize=fuzzer, so the documented `make -f
# Makefile.fuzz …` usage failed to link unless the caller exported
# CXX=clang++ themselves. Override make's built-in default while still
# respecting an explicit environment/command-line CXX (OSS-Fuzz-style).
ifeq ($(origin CXX),default)
  CXX := clang++
endif
CPP_DIR := ..

# libFuzzer is the default driver locally; OSS-Fuzz substitutes its
# own engine via $LIB_FUZZING_ENGINE.
LIB_FUZZING_ENGINE ?= -fsanitize=fuzzer

CXXSTD := -std=c++20
INCLUDES := -I$(CPP_DIR)
# The Rec 34 schema codecs are header-only over the vendored FlatBuffers
# runtime; fuzz_ipc_schema needs its include path.
FLATBUF_INCLUDE := -I$(CPP_DIR)/vendor/flatbuffers/include
WARN := -Wall -Wno-sign-compare

SAN :=
ifeq ($(ASAN),1)
  SAN += -fsanitize=address
endif
ifeq ($(UBSAN),1)
  SAN += -fsanitize=undefined
endif

CXXFLAGS += $(CXXSTD) -O1 -g $(WARN) $(INCLUDES) $(SAN) -fno-omit-frame-pointer

# Minimum set of decompiler object files needed to link a harness.
# The full set lives in $(CPP_DIR)/Makefile under DECOMP_OBJS; we
# track only the subset required by each harness here for build speed.
# (Grown 2026-06-11: space.o now pulls AddrSpaceManager's key function
# from translate.o, which in turn needs float/pcoderaw/globalcontext/
# opcodes — link-verified as the current minimal closure.)
XML_OBJS := \
    $(CPP_DIR)/xml.o \
    $(CPP_DIR)/marshal.o \
    $(CPP_DIR)/address.o \
    $(CPP_DIR)/space.o \
    $(CPP_DIR)/translate.o \
    $(CPP_DIR)/float.o \
    $(CPP_DIR)/pcoderaw.o \
    $(CPP_DIR)/globalcontext.o \
    $(CPP_DIR)/opcodes.o

MARSHAL_OBJS := $(XML_OBJS)

.PHONY: all clean fuzz_xml fuzz_marshal fuzz_ipc_schema

all: fuzz_xml fuzz_marshal fuzz_ipc_schema

fuzz_xml: fuzz_xml.cc $(XML_OBJS)
	$(CXX) $(CXXFLAGS) $(LIB_FUZZING_ENGINE) $^ -o $@

fuzz_marshal: fuzz_marshal.cc $(MARSHAL_OBJS)
	$(CXX) $(CXXFLAGS) $(LIB_FUZZING_ENGINE) $^ -o $@

# Header-only: the schema codecs are inline over the vendored FlatBuffers
# runtime, so this harness links no decompiler object files.
fuzz_ipc_schema: fuzz_ipc_schema.cc
	$(CXX) $(CXXFLAGS) $(FLATBUF_INCLUDE) $(LIB_FUZZING_ENGINE) $^ -o $@

clean:
	rm -f fuzz_xml fuzz_marshal fuzz_ipc_schema

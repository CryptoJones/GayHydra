<script>
  <com>lo fu identity</com>
  <com>decompile</com>
  <com>print C</com>
  <com>option stackalias on</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<stringmatch name="GH8500 #1: stock output returns the uninitialized stack local (bug reproduces, default off)" min="1" max="1">return \w*Stack_\w+;</stringmatch>
<stringmatch name="GH8500 #2: option stackalias on holds the store-through-pointer live and returns the parameter" min="1" max="1">return param_1;</stringmatch>

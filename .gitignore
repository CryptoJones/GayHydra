excludedFiles.txt
ghidra.repos.config

# Misc files produced while executing application
repositories/
dependencies/
flatRepo/
Ghidra/.ghidraSvrKeys
wrapper.log*
# Stray log4j sink files: a headless/test run with an unresolved
# ${sys:logFilename} / ${sys:scriptLogFilename} property drops literally
# named files into the module dir, which then trips the `ip` task's
# IP-header gate on the next build. Ignore them so they never get staged.
${sys:logFilename}
${sys:scriptLogFilename}
**/${sys:logFilename}
**/${sys:scriptLogFilename}

Thumbs.db
.DS_Store
.svn

/*/*/*/*/*/bin/
/*/*/*/*/*/build/
/*/*/*/*/bin/
/*/*/*/*/build/
/*/*/*/bin/
/*/*/*/build/
/*/*/bin/
/*/*/build/
/*/bin/
/*/build/
/build/
/bin/

**/dist

# Ignore Sleigh generated files
*.sla
**/data/build.xml

# Misc files
*.setting
*.settings
*.directory
.gradle/

# File locks
*.ulock
*.lock

# Ignore object files
*.o
*.obj
*.class
# ...except the hint-recall corpus: the committed .o bytes ARE the corpus
# (samples/hint-recall-corpus/README.md) — recall is pinned to exact codegen.
!samples/hint-recall-corpus/objects/*.o

# Ignore MS Visual Studio artifcats
Release
#Debug
*.ncb
*.suo
*.aps
*.vcproj.*
*.vcxproj.*
*.mdmp
.vs/
.editorconfig/

# Ignore Visual Studio Code files
.vscode/

# Ignore UNIX backup files
*~
*.swp

# Ignore eclipse project files
.project
.classpath
.settings/
.prefs
.pydevproject

# Ignore XTEXT generated dirs/files
*/*/*/*/xtend-gen
*/*/*/*/src-gen
*/*/*/*/model/generated
*/*/*/*/test-bin

# Ignore Intellij metadata
*.iml
.idea/

# Ignore logs and core dumps
*.log
core.*
!core.png
!core.py

# python files
*.egg-info
__pycache__

gradle.lockfile